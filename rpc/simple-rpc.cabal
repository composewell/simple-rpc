cabal-version:      2.4
name:               simple-rpc
version:            0.1.0.0

extra-source-files: CHANGELOG.md

flag limit-build-mem
  description: Limits the GHC heap when building
  manual: True
  default: False

common compile-options
    default-language: Haskell2010
    ghc-options:    -Weverything
                    -Wno-implicit-prelude
                    -Wno-missing-deriving-strategies
                    -Wno-missing-exported-signatures
                    -Wno-missing-import-lists
                    -Wno-missing-local-signatures
                    -Wno-missing-safe-haskell-mode
                    -Wno-missed-specialisations
                    -Wno-all-missed-specialisations
                    -Wno-monomorphism-restriction
                    -Wno-prepositive-qualified-module
                    -Wno-unsafe
                    -Rghc-timing

    if impl(ghc >= 9.2)
      ghc-options:
        -Wno-missing-kind-signatures
        -Wno-redundant-bang-patterns
        -Wno-operator-whitespace

    if impl(ghc >= 9.8)
      ghc-options: -Wno-missing-role-annotations

    if flag(limit-build-mem)
      ghc-options: +RTS -M2G -RTS

common default-extensions
    default-extensions: TemplateHaskell
                      , QuasiQuotes
                      , ScopedTypeVariables
                      , TupleSections

common lib-options
    import: compile-options,  default-extensions

library
    import: lib-options
    exposed-modules: Simple.RPC
                   , Simple.RPC.Server
                   , Simple.RPC.Client
                   , Simple.RPC.Common
    other-modules:   Simple.RPC.Internal.TH
                   , Simple.RPC.Internal.Types
    build-depends:    base
                    , streamly-bytestring
                    , streamly-core
                    , streamly-process
                    , template-haskell
                    , aeson
                    , filepath
                    , unordered-containers
    hs-source-dirs:   lib

test-suite simple-rpc-test
    import: lib-options
    type: exitcode-stdio-1.0
    main-is: Main.hs
    other-modules: Fake
                 , Harness
                 , TestFunctions
                 , TestUtil
    hs-source-dirs: test
    -- The test executable also runs as the RPC server for the tests.
    ghc-options: -threaded -rtsopts -with-rtsopts=-M1G
    build-depends:    base
                    , simple-rpc
                    , QuickCheck
                    , aeson
                    , bytestring
                    , directory
                    , filepath
                    , process >= 1.6.12
                    , streamly-core
                    , streamly-process
                    , unordered-containers

benchmark simple-rpc-bench
    import: lib-options
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: benchmark
    -- The benchmark executable also runs as the RPC server.
    ghc-options: -threaded -rtsopts -with-rtsopts=-M1G
    build-depends:    base
                    , simple-rpc
                    , aeson
                    , streamly-core
